# Django core settings
DJANGO_SECRET_KEY=replace-this-in-real-environments
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=UTC

# Database
# Default local setup uses SQLite. Relative paths are resolved from the repo root.
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3

# Example PostgreSQL settings for future environments:
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=r_hcm
# DJANGO_DB_USER=postgres
# DJANGO_DB_PASSWORD=postgres
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432
