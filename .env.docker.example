# Django settings for Docker local development
DJANGO_SECRET_KEY=local-docker-dev-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Manila

# Django database settings
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=r_hcm
DJANGO_DB_USER=r_hcm
DJANGO_DB_PASSWORD=r_hcm
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432

# PostgreSQL container settings
POSTGRES_DB=r_hcm
POSTGRES_USER=r_hcm
POSTGRES_PASSWORD=r_hcm
